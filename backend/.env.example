# CalibrationCompass backend environment variables.
# Copy to .env for local dev:  cp .env.example .env
# On Render, set these in the service's "Environment" tab (do NOT commit real values).

# IBM Quantum API token (required for live calibration + QPU calls).
IBM_QUANTUM_TOKEN=your_ibm_quantum_token_here

# Runtime channel and instance. Defaults match the original project.
IBM_CHANNEL=ibm_quantum_platform
IBM_INSTANCE=open-instance

# CORS: comma-separated list of allowed frontend origins.
# Use your Vercel URL in production, e.g. https://calibrationcompass.vercel.app
# "*" allows any origin (fine for a demo).
FRONTEND_ORIGIN=*
